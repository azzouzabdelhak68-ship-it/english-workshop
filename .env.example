# Project Settings → API in your Supabase dashboard
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets (NOT this file — see below) ───────────
# These are set on the server, never committed:
#   supabase secrets set GROQ_API_KEY=gsk_...
#   supabase secrets set YOUTUBE_API_KEY=AIza...
#   supabase secrets set OMDB_API_KEY=...
# The Gemini key is NOT a static secret: staff rotate it at runtime via the
# AI Chat Room settings card (stored in Supabase Vault by update-ai-key).
